# Local Next.js overlay. Copy to `.env.local` and fill in real values.
# `.env.local` is gitignored. This example file is safe to commit.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PeoplePay360

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Hostinger SMTP — smtp.hostinger.com
# 465 + SMTP_SECURE=true (SSL)  or  587 + SMTP_SECURE=false (STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=payroll@yourdomain.com
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_NAME=PeoplePay360
SMTP_FROM_EMAIL=payroll@yourdomain.com
SMTP_REPLY_TO=hr@yourdomain.com
