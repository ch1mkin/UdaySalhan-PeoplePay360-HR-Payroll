# =============================================================================
# PeoplePay360 — environment template
# Copy this file to `.env.local` for Next.js development.
# Never commit real secrets. Configure the same keys in Vercel for deploys.
# =============================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PeoplePay360

# --- Supabase (Project Settings → API) ---
# URL and anon key are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key is server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: used by the Supabase CLI when linking this repo
# SUPABASE_PROJECT_ID=your_project_ref

# --- Hostinger SMTP ---
# Mailboxes → Manage → Email client configuration
# Host: smtp.hostinger.com
# Port 465 with SMTP_SECURE=true  (SSL, recommended)
# Port 587 with SMTP_SECURE=false (STARTTLS)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=payroll@yourdomain.com
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_NAME=PeoplePay360
SMTP_FROM_EMAIL=payroll@yourdomain.com

# Optional reply-to for employee questions about payslips
SMTP_REPLY_TO=hr@yourdomain.com
